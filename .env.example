# Copy to .env and fill in (never commit the real .env).
# Only set the keys for the sources you use; everything is optional
# except RTT_TOKEN when running with --source rtt.

# --- Realtime Trains (required for --source rtt) ---
# From your RTT account / token file.
RTT_TOKEN=

# --- Darwin REST via Rail Data Marketplace (optional) ---
# "Live Departure Board" product -> Specification tab -> Consumer key.
# Per-coach loadings for the page-3 diagram where operators supply them.
DARWIN_TOKEN=
# Only if your product's Try-it URL differs from the default path:
# DARWIN_BASE_URL=https://api1.raildata.org.uk/1010-.../LDBWS/api/20220120

# --- Darwin Kafka push-port via RDM (optional, alternative) ---
# "Darwin Real Time Train Information" product page values.
# Needs: pip install kafka-python
DARWIN_KAFKA_GROUP=
DARWIN_KAFKA_USER=
DARWIN_KAFKA_PASSWORD=
# Usually fine as defaults (uncomment to override):
# DARWIN_KAFKA_BOOTSTRAP=pkc-z3p1v0.europe-west2.gcp.confluent.cloud:9092
# DARWIN_KAFKA_TOPIC=prod-1010-Darwin-Train-Information-Push-Port-IIII2_0-JSON
